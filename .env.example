# Server
HOST=127.0.0.1
PORT=8787
# Optional gateway key. If set, callers must send Authorization: Bearer <key>.
OMNIROUTE_API_KEY=

# Provider credentials. Keep real values out of Git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional provider base URLs (defaults are official API endpoints).
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Request timeout in milliseconds.
REQUEST_TIMEOUT_MS=60000
MAX_BODY_BYTES=1048576
